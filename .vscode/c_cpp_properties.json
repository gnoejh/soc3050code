{
    "configurations": [
        {
            "name": "ARM (STM32C031C6)",
            "includePath": [
                "${fileDirname}",
                "${workspaceFolder}/projects2026_arm/_lib",
                "${workspaceFolder}/tools/cmsis/Core/Include",
                "${workspaceFolder}/tools/cmsis/Device/ST/STM32C0xx/Include"
            ],
            "defines": [
                "STM32C031xx"
            ],
            "compilerPath": "${workspaceFolder}/tools/arm-toolchain/bin/arm-none-eabi-gcc.exe",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-mthumb",
                "-mfloat-abi=soft"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm"
        },
        {
            "name": "AVR (ATmega128)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/shared_libs",
                "${workspaceFolder}/tools/avr-toolchain/avr/include",
                "${workspaceFolder}/tools/avr-toolchain/avr/include/avr",
                "${workspaceFolder}/tools/packs/atmel/ATmega_DFP/1.7.374/include",
                "${workspaceFolder}/tools/packs/atmel/ATmega_DFP/1.7.374/include/avr"
            ],
            "defines": [
                "F_CPU=16000000UL",
                "__AVR_ATmega128__",
                "BAUD=9600",
                "DEBUG"
            ],
            "compilerPath": "${workspaceFolder}/tools/avr-toolchain/bin/avr-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mmcu=atmega128",
                "-DF_CPU=16000000UL",
                "-D__AVR_ATmega128__"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/shared_libs",
                    "${workspaceFolder}/tools/avr-toolchain/avr/include",
                    "${workspaceFolder}/tools/packs/atmel/ATmega_DFP/1.7.374/include"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ],
    "version": 4
}