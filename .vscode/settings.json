{
    // Student environment for SOC3050: the ARM edition (projects2026_arm/,
    // STM32C031C6 in Wokwi) and the frozen AVR edition (projects2026_avr/).
    // Build: Ctrl+Shift+B. Debug an ARM lesson: F5 - see launch.json.
    // Recommended extensions are listed in extensions.json.
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // File associations for embedded development
    "files.associations": {
        "*.c": "c",
        "*.h": "c",
        "*.hex": "intel-hex",
        "*.elf": "binary"
    },
    // C/C++ IntelliSense configured via c_cpp_properties.json
    // Disable error squiggles for AVR cross-compilation (known IntelliSense limitation)
    "C_Cpp.errorSquiggles": "disabled",
    // Python environment configuration
    "python.defaultInterpreterPath": "./.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    // Clean editor settings
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // Hide complex files from students
    "files.exclude": {
        "**/.git": true,
        "**/cmake": true,
        "**/_build": true,
        "**/*.o": true,
        "**/*.d": true,
        "**/Debug": true,
        "**/Release": true
    }
}